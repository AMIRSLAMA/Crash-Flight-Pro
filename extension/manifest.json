{
  "manifest_version": 3,
  "name": "Crash Flight Pro — Live Capture",
  "version": "0.1.0",
  "description": "Opt-in sanitized SignalR event capture on selected Crash game tabs. No betting automation.",
  "permissions": [
    "storage",
    "downloads",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.1xbet.com/*",
    "https://*.eg1xbet.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Crash Flight Pro Capture"
  },
  "background": {
    "service_worker": "background.js"
  }
}