{
  "manifest_version": 3,
  "name": "Crash Flight Pro — Live Capture",
  "version": "0.3.0",
  "description": "Opt-in sanitized SignalR event capture and local dashboard bridge. No betting automation.",
  "permissions": [
    "storage",
    "downloads",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.1xbet.com/*",
    "https://*.eg1xbet.com/*",
    "https://amirslama.github.io/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Crash Flight Pro Capture"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.1xbet.com/*",
        "https://*.eg1xbet.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.1xbet.com/*",
        "https://*.eg1xbet.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://amirslama.github.io/Crash-Flight-Pro/*"
      ],
      "js": [
        "app-bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
